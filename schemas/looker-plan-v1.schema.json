{
  "$id": "https://retirement-conductor.example/schemas/looker-plan-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "minLength": 1,
          "type": "string"
        },
        "mode": {
          "enum": [
            "live",
            "fixture",
            "replay",
            "analysis"
          ]
        },
        "name": {
          "const": "looker"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "api_version",
        "mode"
      ],
      "type": "object"
    },
    "before_execution": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "const": false
        },
        "force_production": {
          "const": true
        },
        "raw_result_retained": {
          "const": false
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "row_limit": {
          "minimum": 1,
          "type": "integer"
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "row_count",
        "row_limit",
        "cache",
        "force_production",
        "semantic_digest",
        "raw_result_retained"
      ],
      "type": "object"
    },
    "before_validation": {
      "$ref": "#/$defs/contentValidation"
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "consumer_id": {
      "minLength": 1,
      "type": "string"
    },
    "datahub_urn": {
      "pattern": "^urn:li:",
      "type": "string"
    },
    "discovery": {
      "additionalProperties": false,
      "properties": {
        "folder_id": {
          "minLength": 1,
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "pages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "offset": {
                "minimum": 0,
                "type": "integer"
              },
              "returned": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "offset",
              "returned"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "pagination_complete": {
          "const": true
        },
        "returned_total": {
          "minimum": 0,
          "type": "integer"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        }
      },
      "required": [
        "targets",
        "pages",
        "page_count",
        "returned_total",
        "pagination_complete",
        "folder_id"
      ],
      "type": "object"
    },
    "graph_snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "mutation": {
      "additionalProperties": false,
      "properties": {
        "actual_changed_fields": {
          "const": [
            "query_id"
          ],
          "type": "array"
        },
        "automatic_mutation_retries": {
          "const": false
        },
        "create_query": {
          "const": "POST /queries"
        },
        "create_query_idempotency": {
          "minLength": 1,
          "type": "string"
        },
        "update_saved_look": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "create_query",
        "update_saved_look",
        "create_query_idempotency",
        "automatic_mutation_retries",
        "actual_changed_fields"
      ],
      "type": "object"
    },
    "native_identity": {
      "$ref": "#/$defs/nativeIdentity"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "preflight_digest": {
      "$ref": "#/$defs/digest"
    },
    "references": {
      "additionalProperties": false,
      "properties": {
        "after_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "after_query_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "changed_query_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "legacy": {
          "minLength": 1,
          "type": "string"
        },
        "legacy_occurrences": {
          "minimum": 1,
          "type": "integer"
        },
        "replacement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "legacy",
        "replacement",
        "legacy_occurrences",
        "changed_query_fields",
        "after_query_fingerprint",
        "after_fingerprint"
      ],
      "type": "object"
    },
    "relevance": {
      "$ref": "#/$defs/relevance"
    },
    "replacement": {
      "additionalProperties": false,
      "properties": {
        "compatible": {
          "const": true
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "explore_field_count": {
          "minimum": 2,
          "type": "integer"
        },
        "replacement": {
          "$ref": "#/$defs/fieldShape"
        },
        "target": {
          "$ref": "#/$defs/fieldShape"
        }
      },
      "required": [
        "target",
        "replacement",
        "compatible",
        "explore_field_count",
        "evidence_digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "look_state_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "query_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "query_id": {
          "minLength": 1,
          "type": "string"
        },
        "schedule_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "fingerprint",
        "query_id",
        "query_fingerprint",
        "schedule_fingerprint",
        "look_state_fingerprint"
      ],
      "type": "object"
    },
    "target_sets": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "$ref": "#/$defs/targets"
        },
        "discovered": {
          "$ref": "#/$defs/targets"
        },
        "proposed": {
          "$ref": "#/$defs/targets"
        }
      },
      "required": [
        "proposed",
        "approved",
        "discovered"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "consumer_id",
    "datahub_urn",
    "graph_snapshot_digest",
    "adapter",
    "native_identity",
    "source",
    "replacement",
    "references",
    "target_sets",
    "discovery",
    "relevance",
    "before_validation",
    "before_execution",
    "mutation",
    "preflight_digest",
    "limitations",
    "plan_digest"
  ],
  "title": "Looker plan v1",
  "type": "object",
  "$defs": {
    "contentValidation": {
      "additionalProperties": false,
      "properties": {
        "computation_time": {},
        "error_count": {
          "minimum": 0,
          "type": "integer"
        },
        "errors_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "project_names": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "space_ids": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "project_names",
            "space_ids"
          ],
          "type": "object"
        },
        "total_dashboard_elements_validated": {
          "minimum": 0,
          "type": "integer"
        },
        "total_dashboards_validated": {
          "minimum": 0,
          "type": "integer"
        },
        "total_looks_validated": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "error_count",
        "errors_digest",
        "total_looks_validated",
        "total_dashboard_elements_validated",
        "total_dashboards_validated",
        "computation_time"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fieldShape": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "type": "string"
        },
        "is_numeric": {
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "type",
        "is_numeric"
      ],
      "type": "object"
    },
    "nativeIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "minLength": 1,
          "type": "string"
        },
        "content_metadata_id": {
          "minLength": 1,
          "type": "string"
        },
        "content_type": {
          "const": "look"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "datahub_urn": {
          "pattern": "^urn:li:",
          "type": "string"
        },
        "explore_id": {
          "minLength": 1,
          "type": "string"
        },
        "folder_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "platform_instance": {
          "minLength": 1,
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_domain": {
          "const": "looker"
        }
      },
      "required": [
        "source_domain",
        "content_type",
        "platform_instance",
        "project_id",
        "model_id",
        "explore_id",
        "folder_id",
        "content_id",
        "content_metadata_id",
        "created_at",
        "datahub_urn"
      ],
      "type": "object"
    },
    "relevance": {
      "additionalProperties": false,
      "properties": {
        "alerts": {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "const": "NOT_APPLICABLE"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        },
        "calculations": {
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "unsupported_and_refused"
            },
            "present": {
              "type": "boolean"
            },
            "status": {
              "const": "EVALUATED"
            }
          },
          "required": [
            "status",
            "present",
            "policy"
          ],
          "type": "object"
        },
        "filters": {
          "additionalProperties": false,
          "properties": {
            "included_in_query_fingerprint": {
              "const": true
            },
            "present": {
              "type": "boolean"
            },
            "status": {
              "const": "EVALUATED"
            }
          },
          "required": [
            "status",
            "present",
            "included_in_query_fingerprint"
          ],
          "type": "object"
        },
        "merged_result": {
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "unsupported_and_refused"
            },
            "present": {
              "type": "boolean"
            },
            "status": {
              "const": "EVALUATED"
            }
          },
          "required": [
            "status",
            "present",
            "policy"
          ],
          "type": "object"
        },
        "schedules": {
          "additionalProperties": false,
          "properties": {
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "policy": {
              "const": "must_be_empty"
            },
            "status": {
              "const": "EVALUATED"
            }
          },
          "required": [
            "status",
            "count",
            "policy"
          ],
          "type": "object"
        }
      },
      "required": [
        "schedules",
        "filters",
        "calculations",
        "alerts",
        "merged_result"
      ],
      "type": "object"
    },
    "targets": {
      "items": {
        "pattern": "^look:[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  }
}
