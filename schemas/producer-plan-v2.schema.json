{
  "$id": "https://retirement-conductor.example/schemas/producer-plan-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producer retirement plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "prepared_at",
    "expires_at",
    "writer_id",
    "trusted_run",
    "manifest",
    "producer_source",
    "git_dbt",
    "superset",
    "action",
    "limitations",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "prepared_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "writer_id": {"type": "string", "minLength": 1},
    "trusted_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "decision",
        "specification_digest",
        "evidence_envelope_digest",
        "reconciliation_digest",
        "publication_content_digest",
        "published_manifest_digest",
        "input_digests",
        "receipt_digests"
      ],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "decision": {"const": "READY_TO_RETIRE"},
        "specification_digest": {"$ref": "#/$defs/digest"},
        "evidence_envelope_digest": {"$ref": "#/$defs/digest"},
        "reconciliation_digest": {"$ref": "#/$defs/digest"},
        "publication_content_digest": {"$ref": "#/$defs/digest"},
        "published_manifest_digest": {"$ref": "#/$defs/digest"},
        "input_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/digest"}
        },
        "receipt_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "producer_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity",
        "remote_identity",
        "branch",
        "version",
        "working_tree_clean",
        "marker_path",
        "marker_digest"
      ],
      "properties": {
        "repository_identity": {"$ref": "#/$defs/digest"},
        "remote_identity": {"$ref": "#/$defs/digest"},
        "branch": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "working_tree_clean": {"const": true},
        "marker_path": {"type": "string", "minLength": 1},
        "marker_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "git_dbt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_digest",
        "preflight_digest",
        "migration_plan_digest",
        "apply_digest",
        "validation_digest",
        "receipt_digest",
        "validator_binding_digest",
        "artifact_set_digest"
      ],
      "properties": {
        "settings_digest": {"$ref": "#/$defs/digest"},
        "preflight_digest": {"$ref": "#/$defs/digest"},
        "migration_plan_digest": {"$ref": "#/$defs/digest"},
        "apply_digest": {"$ref": "#/$defs/digest"},
        "validation_digest": {"$ref": "#/$defs/digest"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "validator_binding_digest": {"$ref": "#/$defs/digest"},
        "artifact_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "superset": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer_id",
          "datahub_urn",
          "binding_digest",
          "plan_digest",
          "receipt_digest",
          "validation_digest"
        ],
        "properties": {
          "consumer_id": {"type": "string", "minLength": 1},
          "datahub_urn": {"type": "string", "minLength": 1},
          "binding_digest": {"$ref": "#/$defs/digest"},
          "plan_digest": {"$ref": "#/$defs/digest"},
          "receipt_digest": {"$ref": "#/$defs/digest"},
          "validation_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "action_id",
        "action_digest",
        "postgres_action_plan"
      ],
      "properties": {
        "type": {"const": "postgres_drop_column_v1"},
        "action_id": {"type": "string", "minLength": 1},
        "action_digest": {"$ref": "#/$defs/digest"},
        "postgres_action_plan": {
          "type": "object",
          "required": [
            "schema_version",
            "adapter_version",
            "action_type",
            "action_count",
            "target",
            "before_schema_fingerprint",
            "replacement_column",
            "action_expires_at",
            "cascade",
            "action_digest"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "plan_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
