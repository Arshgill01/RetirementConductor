{
  "$id": "https://retirement-conductor.example/schemas/producer-plan-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "type": "string"
        },
        "sentinel_root_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "type": {
          "const": "write_public_safe_sentinel"
        }
      },
      "required": [
        "type",
        "action_id",
        "sentinel_root_identity",
        "relative_path"
      ],
      "type": "object"
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "git_dbt": {
      "additionalProperties": false,
      "properties": {
        "apply_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "artifact_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "migration_plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "preflight_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "settings_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "validation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "validator_binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "settings_digest",
        "preflight_digest",
        "migration_plan_digest",
        "apply_digest",
        "validation_digest",
        "receipt_digest",
        "validator_binding_digest",
        "artifact_set_digest"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "READY_TO_RETIRE"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_envelope_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "input_digests": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        "publication_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "published_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reconciliation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "specification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "decision",
        "specification_digest",
        "evidence_envelope_digest",
        "reconciliation_digest",
        "publication_content_digest",
        "published_manifest_digest",
        "input_digests",
        "receipt_digests"
      ],
      "type": "object"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "type": "string"
    },
    "producer_source": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "minLength": 1,
          "type": "string"
        },
        "marker_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "marker_path": {
          "minLength": 1,
          "type": "string"
        },
        "remote_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "repository_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "working_tree_clean": {
          "const": true
        }
      },
      "required": [
        "repository_identity",
        "remote_identity",
        "branch",
        "version",
        "working_tree_clean",
        "marker_path",
        "marker_digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "trusted_run": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider"
      ],
      "type": "object"
    },
    "writer_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "prepared_at",
    "expires_at",
    "writer_id",
    "trusted_run",
    "manifest",
    "producer_source",
    "git_dbt",
    "action",
    "limitations",
    "plan_digest"
  ],
  "title": "Producer retirement plan v1",
  "type": "object"
}
